  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  authority      String // port state authority
  mouRegion      String? // e.g. Tokyo MOU, Paris MOU, USCG
  port           String?
  inspectionDate DateTime
  detained       Boolean  @default(false)
  summary        String?

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  deficiencies PscDeficiency[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
}

model PscDeficiency {
  id                   String             @id @default(uuid())
  companyId            String
  inspectionId         String
  inspection           PscInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  natureCode           String? // PSC nature-of-deficiency code
  reference            String? // convention reference (e.g. SOLAS III/19)
  description          String
  actionCode           String? // PSC action code, e.g. 17 (rectify), 30 (detainable)
  // Root cause classification — same shared taxonomy as Incident/Near
  // Miss/NCR (lib/root-cause.ts). Corrective actions themselves live in
  // CapaAction (entityType "PscDeficiency"), replacing the old free-text
  // rectification field with the same tracker used company-wide.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  // Resolved status is derived from its linked CapaAction rows (all Closed =
  // rectified), not stored — a manual flag here could drift out of sync with
  // the actual corrective actions, which is exactly what caused inspections
  // to close with CAPA items still open. See closePscAction.

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

