model SireObservation {
  id           String         @id @default(uuid())
  companyId    String
  inspectionId String
  inspection   SireInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Stable per-inspection ordinal for "Observation No. N" — assigned once at
  // creation, so it doesn't shift if an earlier observation is later deleted.
  seq         Int
  chapter     Int? // OCIMF VIQ chapter, 1–13
  category    SireObservationCategory?
  viqRef      String? // Question number, e.g. "3.5.1"
  question    String? // the VIQ question text, for reference
  observation String // Finding / Inspector Observation

  immediateCause       String?
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  correctiveAction     String?
  preventiveMeasure    String?

  responsiblePersonId  String?
  responsiblePerson    User?     @relation("SireObservationResponsible", fields: [responsiblePersonId], references: [id])
  targetDate           DateTime?
  actualCompletionDate DateTime?

  status SireObservationStatus @default(OPEN)

  verifiedById String?
  verifiedBy   User?   @relation("SireObservationVerifier", fields: [verifiedById], references: [id])

  comments SireObservationComment[]

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

model SireObservationComment {
  id            String          @id @default(uuid())
  companyId     String
  observationId String
  observation   SireObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?           @relation("SireObservationCommentAuthor", fields: [authorId], references: [id])
  body          String

  createdAt DateTime @default(now())

  @@index([observationId])
}

// ─── Phase 1 module: PSC Inspection (Port State Control) ─────────────────────

model PscInspection {
  id        String  @id @default(uuid())
