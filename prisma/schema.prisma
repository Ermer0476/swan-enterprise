// ═══════════════════════════════════════════════════════════════════════════
//  SWAN Enterprise — Prisma schema (PostgreSQL 15, local dev)
//
//  Conventions (enforced across every business table):
//    • id         String  @id @default(uuid())         — UUID primary key
//    • companyId  String                                — multi-tenant scope
//    • createdAt / updatedAt                            — timestamps
//    • createdBy / updatedBy / deletedBy  String?       — actor user ids
//    • deletedAt  DateTime?                             — soft delete
//
//  Audit-column actor ids (createdBy/updatedBy/deletedBy) are stored as scalar
//  strings rather than enforced foreign keys. This is deliberate: enforcing a
//  User relation for each would create dozens of ambiguous back-relations on
//  User. The AuditLog table is the system of record for "who did what".
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DepartmentType {
  EXECUTIVE
  MARINE
  TECHNICAL
  OPERATIONS
  CREWING
  PURCHASING
  ACCOUNTING
  ADMIN
  HR
  IT
  QHSE
  SHIPBOARD
}

enum VesselStatus {
  ACTIVE
  LAID_UP
  DRYDOCK
  SOLD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUBMIT
  LOGIN
  LOGOUT
  SYNC
  UPLOAD
  DOWNLOAD
  PRINT
  EXPORT
}

enum NotificationType {
  INFO
  APPROVAL_REQUEST
  APPROVAL_RESULT
  MENTION
  ASSIGNMENT
  DEADLINE
  SYSTEM
}

enum WorkflowInstanceStatus {
  DRAFT
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum ApproverType {
  ROLE
  DEPARTMENT
  SPECIFIC_USER
}

enum WorkflowDecision {
  APPROVE
  REJECT
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

// An incident may be tagged with several types at once (multi-select). Each
// tagged type carries its own sub-category (see IncidentTypeEntry) — the
// specific sub-category list is app-defined per type, not enforced here.
enum IncidentType {
  PERSONAL_INJURY
  OCCUPATIONAL_ILLNESS
  ENVIRONMENTAL
  PROPERTY_EQUIPMENT_DAMAGE
  LOSS_OF_CONTAINMENT
  FIRE_EXPLOSION
  NAVIGATION_MARINE
  CARGO_OPERATION
  MOORING_OPERATION
  SECURITY
  CYBER_SECURITY
  REGULATORY_COMPLIANCE
  OPERATIONAL
}

enum IncidentStatus {
  // The reporter's own work-in-progress — invisible to everyone else until
  // "Report Incident" moves it to REPORTED. See features/incidents/queries.ts.
  DRAFT
  REPORTED
  UNDER_INVESTIGATION
  ACTION_PENDING
  CLOSED
}

// Structured root-cause category (the 6M + governance).
enum RootCauseCategory {
  PROCESS_METHODS
  HUMAN_FACTORS
  EQUIPMENT_SOFTWARE
  MATERIALS
  MEASUREMENT_INFORMATION
  ENVIRONMENT_WORK_CONDITIONS
  MANAGEMENT_GOVERNANCE
}

// Human-factor tags — used for the primary factor (one) and contributing
// factors (up to two, enforced in the form and server action).
// CAPA tracker (TMSA-style) — corrective (CA-##) and preventive (PA-##) actions.
enum CapaKind {
  CORRECTIVE
  PREVENTIVE
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Shared risk severity used by Incident, Near Miss, Hazard and NCR modules.
enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Near Miss ────────────────────────────────────────────────────────────
enum NearMissStatus {
  DRAFT
  REPORTED
  UNDER_REVIEW
  CLOSED
}

// Potential consequence type — the kind of event that could have happened.
enum NearMissConsequenceType {
  INJURY_ILL_HEALTH
  ENVIRONMENTAL_DAMAGE
  PROPERTY_DAMAGE
  FIRE_EXPLOSION
  LOSS_OF_CONTAINMENT
  NAVIGATION_MARINE_INCIDENT
  SECURITY
  REGULATORY
}

// Near Miss vs Hazard Observation (HOR) — one merged report/module; a HOR
// additionally carries a HazardType (Unsafe Act / Unsafe Condition).
enum NearMissKind {
  NEAR_MISS
  HOR
}

// Reused as NearMiss.horCategory when kind = HOR.
enum HazardType {
  UNSAFE_ACT
  UNSAFE_CONDITION
}

// ─── Non-Conformity (NCR) ────────────────────────────────────────────────────
enum NcrSource {
  INTERNAL_AUDIT
  EXTERNAL_AUDIT
  PSC
  SIRE
  CDI
  VETTING
  FLAG_STATE
  OTHER
}

// Simple user-facing lifecycle. Verification IS the closing act — only DPA /
// General Manager hold ncr:close, mirroring how Incident "Verified by
// Management" is captured (closing = verification, not a separate step).
enum NcrStatus {
  DRAFT
  OPEN
  SUBMITTED_TO_OFFICE
  CLOSED
}

// ─── External Inspections (SIRE / PSC / CDI) ────────────────────────────────
//  Each regime is its own module but shares the inspection/finding lifecycle.
//  InternalAudit does NOT use this — it has its own InternalAuditStatus below
//  (it alone needed a DRAFT state; adding DRAFT here would leak into every
//  other model that shares this enum: SIRE/PSC/CDI/CompanyInspection/
//  ExternalAudit).
enum InspectionStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Dedicated to InternalAudit only — kept separate from InspectionStatus (see
// comment above) so DRAFT doesn't leak into the other inspection modules.
enum InternalAuditStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FindingStatus {
  OPEN
  CLOSED
}

// Dedicated to EmergencyDrill only — kept separate from FindingStatus (also
// used by CdiObservation) so DRAFT doesn't leak into CDI observations.
enum DrillStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SireInspectionType {
  LOADING_OPERATION
  DISCHARGING_OPERATION
  BUNKERING
  IDLE
}

enum SireOverallResult {
  SATISFACTORY
  OBSERVATIONS
  MAJOR_CONCERN
}

// Which discipline a Company Inspection covers — see CompanyInspection.inspectionType.
enum CompanyInspectionType {
  TECHNICAL
  SAFETY
}

// See CompanyInspection.visitKind.
enum CompanyInspectionVisitKind {
  PORT_VISIT
  SAILING_VISIT
}

// SIRE observations run a longer lifecycle than the generic FindingStatus
// (OPEN/CLOSED) — verification is its own step, not just a status label.
enum SireObservationStatus {
  OPEN
  ONGOING
  PENDING_VERIFICATION
  CLOSED
}

// SIRE 2.0 observation category.
enum SireObservationCategory {
  HARDWARE
  PROCESS
  HUMAN
  PHOTOGRAPH
}

// CDI checklist section. 5LP is type-specific (LPG cargo operations).
enum CdiObservationSection {
  SECTION_1
  SECTION_2
  SECTION_3
  SECTION_4
  SECTION_5LP
  SECTION_6
  SECTION_7
  SECTION_8
  SECTION_9
  SECTION_10
  SECTION_11
  SECTION_12
  SECTION_13
  SECTION_14
}

// Audit finding severity (Internal & External audits share this).
enum AuditFindingCategory {
  MAJOR_NC
  MINOR_NC
  OBSERVATION
}

// ─── Tenancy & Organization ───────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exposure Hours KPI dashboard targets (LTIF/TRCF), per-million-hours rate.
  // Editable at /settings/exposure-kpi — see exposure:manage-targets.
  ltifTarget Float @default(1.0)
  trcfTarget Float @default(4.0)

  // SIRE KPI dashboard target: average observations per inspection, fleet-wide.
  // Editable at /settings/sire-kpi — see sire:manage-targets.
  sireAvgObservationTarget Float @default(3.0)

  // Company Inspection KPI dashboard target: average observations per
  // inspection, fleet-wide — same pattern as SIRE's target, kept on its own
  // field since the two modules' observation volumes aren't comparable.
  // Editable at /settings/company-inspections-kpi — see cinsp:manage-targets.
  cinspAvgObservationTarget Float @default(3.0)

  // Procurement requisition approval routing thresholds (peso amounts).
  // Routing logic that consumes these is a later build — see
  // features/procurement/. Editable at /settings/procurement-thresholds —
  // see procurement:manage-thresholds.
  procurementThresholdSupt        Float @default(50000)
  procurementThresholdTechManager Float @default(500000)

  users                      User[]
  roles                      Role[]
  vessels                    Vessel[]
  smsDocuments               SmsDocument[]
  workflows                  WorkflowDefinition[]
  incidents                  Incident[]
  nearMisses                 NearMiss[]
  nonConformities            NonConformity[]
  sireInspections            SireInspection[]
  sireQuestionnaireVersions  SireQuestionnaireVersion[]
  pscInspections             PscInspection[]
  cdiInspections             CdiInspection[]
  internalAudits             InternalAudit[]
  externalAudits             ExternalAudit[]
  companyInspections         CompanyInspection[]
  committeeMeetings          CommitteeMeeting[]
  scheduleItems              ScheduleItem[]
  emergencyDrills            EmergencyDrill[]
  familiarizationRecords     FamiliarizationRecord[]
  familiarizationSessions    FamiliarizationSession[]
  scheduleApplicability      ScheduleApplicability[]
  lsaFfeItems                LsaFfeItem[]
  crewFamiliarizations       CrewFamiliarization[]
  refSequences               RefSequence[]
  controlledDocuments        ControlledDocument[]
  circulars                  Circular[]
  riskAssessmentDocuments    RiskAssessmentDocument[]
  defects                    Defect[]
  crewFamiliarizationRecords CrewFamiliarizationRecord[]
  vesselDocuments            VesselDocument[]
  voyageLogs                 VoyageLog[]
  environmentRecords         EnvironmentRecord[]
  tmsaAssessments            TmsaAssessment[]
  tmsaScores                 TmsaScore[]
  tmsaFindings               TmsaFinding[]
  storesCatalogueItems       StoresCatalogueItem[]
  sparesCatalogueItems       SparesCatalogueItem[]
  openingStockTakes          OpeningStockTake[]
  inventoryEvents            InventoryEvent[]
  inventoryUpdateDrafts      InventoryUpdateDraft[]
  requisitions               Requisition[]
  requisitionRevisions       RequisitionRevision[]
  unitMasters                UnitMaster[]
  referenceListItems         ReferenceListItem[]

  // How far ahead of its Expired date a certificate is flagged with a
  // warning icon on the Vessel Documentation / Company Documents registers.
  documentExpiryWarningMonths Int @default(3)

  // Operational timing windows (days). Editable at /settings/operational-windows
  // — see settings:manage-windows. Defaults match the constants they replaced.
  //   incidentOverdueDays      — an open investigation past this many days is
  //                              flagged "overdue" on the Incidents KPI.
  //   sireDueSoonDays          — a SIRE inspection due within this many days is
  //                              flagged "due soon" on the SIRE schedule.
  //   internalAuditDueSoonDays — an internal audit due within this many days is
  //                              flagged "due soon" on the internal-audit schedule.
  incidentOverdueDays      Int @default(30)
  sireDueSoonDays          Int @default(30)
  internalAuditDueSoonDays Int @default(30)

  // Default OCIMF SIRE programme version pre-filled on a new SIRE inspection
  // when the form leaves it blank (was a dead @default on the inspection row).
  defaultSireVersion String? @default("2.0")
}

model User {
  id           String         @id @default(uuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  fullName     String
  email        String         @unique
  passwordHash String
  department   DepartmentType
  rank         String? // e.g. Master, Chief Engineer — for shipboard users
  active       Boolean        @default(true)
  lastLoginAt  DateTime?

  // Which vessel this account represents — only meaningful for
  // department = SHIPBOARD (one account per ship, e.g. the Master's login).
  // Null for office accounts, which aren't tied to a single vessel.
  vesselId String?
  vessel   Vessel? @relation("UserVessel", fields: [vesselId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  roles              UserRole[]
  ownedDocs          SmsDocument[]            @relation("DocumentOwner")
  reportedIncidents  Incident[]               @relation("IncidentReporter")
  reportedNearMisses NearMiss[]               @relation("NearMissReporter")
  raisedNcrs         NonConformity[]          @relation("NcrRaisedBy")
  notifications      Notification[]
  sireResponsibleFor SireObservation[]        @relation("SireObservationResponsible")
  sireVerifierFor    SireObservation[]        @relation("SireObservationVerifier")
  sireComments       SireObservationComment[] @relation("SireObservationCommentAuthor")

  @@index([companyId])
  @@index([department])
  @@index([vesselId])
}

// ─── RBAC (data-driven, not hardcoded) ─────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  isSystem    Boolean  @default(false) // system roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "sms:read", "sms:approve", "incident:create"
  module      String // e.g. "sms", "incident"
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─── Fleet ──────────────────────────────────────────────────────────────────

model Vessel {
  id                    String       @id @default(uuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id])
  name                  String
  // Short internal fleet code (e.g. "SWA") — prefixed onto every
  // vessel-raised ref number (SWA-DR-2026-0001, SWA-NCR-2026-0001, ...) so
  // two ships' Nth report of the year never look alike once everything
  // lands in the office's central register. Mandatory and unique — every
  // vessel must have one before it can raise a vessel-linked report.
  code                  String       @unique
  // Optional so real-fleet vessels can be entered before their official IMO
  // number is on file (e.g. bulk-imported from the fleet register) — fill
  // it in later once confirmed. Still unique whenever it IS set.
  imo                   String?      @unique
  officialNumber        String?
  callSign              String?
  mmsi                  String?
  flag                  String?
  type                  String
  classificationSociety String?
  yearBuilt             Int?
  grossTonnage          Float?
  loa                   Float? // Length Overall (m)
  breadth               Float? // (m)
  depth                 Float? // (m)
  status                VesselStatus @default(ACTIVE)

  // Commercial / fleet-register particulars — merged in from the Swan-GCC
  // (GM Command Center) fleet list, which tracks these for OPEX/TMSA
  // purposes. Kept alongside the technical particulars above rather than
  // replacing them, since IMO/Call Sign/MMSI/Classification Society are
  // relied on across the QHSE modules (Incident, SIRE, PSC, CDI, etc.).
  capacityCbm     Float? // Cargo capacity (CBM)
  netTonnage      Float?
  deadweight      Float? // DWT
  tradeArea       String? // e.g. "FE / SEA", "West Africa", "CARIB"
  registeredOwner String?
  headOwner       String?
  charterer       String?
  yearWithSwan    Int? // Year the vessel joined the Swan fleet
  lastDryDock     DateTime?
  dryDockPlace    String?
  nextDryDockDue  DateTime?

  // Ship's Particulars — from the vessel's official particulars sheet.
  portOfRegistry  String?
  lbp             Float? // Length Between Perpendiculars (m)
  draft           Float? // Draft, extreme (m)
  mainEngine      String? // e.g. "HITACHI MAN B&W 6S35ME-B9.7-HPSCR x 1 set"
  serviceSpeed    Float? // knots
  // Standard daily consumption from sea trial — manually set per vessel
  // (not derived from voyage-log history), used as the KPI dashboard's
  // fuel-consumption threshold line.
  stdFoConsumptionMt Float? // mt/day
  stdDoConsumptionMt Float? // mt/day
  navigationArea  String? // e.g. "OCEAN GOING"
  classNotation   String?
  ownerAddress    String?
  builder         String?
  keelLaidDate    DateTime?
  launchingDate   DateTime?
  deliveryDate    DateTime?
  totalComplement Int? // Grand total complement (persons)
  satPhone        String? // V-SAT / satellite phone number
  vesselEmail     String?
  // When this vessel left the fleet (sold / no longer managed) — set
  // automatically when status is changed to SOLD (and cleared if changed
  // back). Drives the "vessels under management by year" fleet history
  // chart, which needs an exact exit year, not just the current status.
  archivedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  smsDocuments                   SmsDocument[]
  incidents                      Incident[]
  nearMisses                     NearMiss[]
  nonConformities                NonConformity[]
  sireInspections                SireInspection[]
  pscInspections                 PscInspection[]
  cdiInspections                 CdiInspection[]
  internalAudits                 InternalAudit[]
  externalAudits                 ExternalAudit[]
  companyInspections             CompanyInspection[]
  committeeMeetings              CommitteeMeeting[]
  emergencyDrills                EmergencyDrill[]
  familiarizationRecords         FamiliarizationRecord[]
  familiarizationSessions        FamiliarizationSession[]
  scheduleApplicability          ScheduleApplicability[]
  crewFamiliarizations           CrewFamiliarization[]
  controlledDocuments            ControlledDocument[]
  circulars                      Circular[]
  riskAssessmentDocuments        RiskAssessmentDocument[]        @relation("RaDocumentVessel")
  riskAssessmentExecutions       RiskAssessmentExecution[]       @relation("RaExecutionVessel")
  riskAssessmentRevisionRequests RiskAssessmentRevisionRequest[] @relation("RaRevisionRequestVessel")
  riskHazardRows                 RiskHazardRow[]                 @relation("RaHazardRowVessel")
  defects                        Defect[]
  vesselDocuments                VesselDocument[]
  users                          User[]                          @relation("UserVessel")
  voyageLogs                     VoyageLog[]
  environmentRecords             EnvironmentRecord[]
  storesCatalogueItems           StoresCatalogueItem[]
  sparesCatalogueItems           SparesCatalogueItem[]
  openingStockTake                OpeningStockTake?
  inventoryEvents                InventoryEvent[]
  inventoryUpdateDrafts           InventoryUpdateDraft[]
  requisitions                   Requisition[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ─── Shared services ──────────────────────────────────────────────────────────

/// Immutable audit trail — the system of record for "who did what, when".
model AuditLog {
  id         String      @id @default(uuid())
  companyId  String
  actorId    String? // null for anonymous/system events
  actorName  String? // denormalized snapshot — survives user deletion
  action     AuditAction
  entityType String // e.g. "SmsDocument"
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([actorId])
}

/// Polymorphic attachment — belongs to any entity via (entityType, entityId).
model Attachment {
  id         String @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  fileName   String
  fileKey    String // storage key — local disk path today, DigitalOcean Spaces object key later
  mimeType   String
  sizeBytes  Int

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, entityType, entityId])
}

/// Polymorphic comment thread — belongs to any entity.
model Comment {
  id         String @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  authorId   String
  authorName String // denormalized snapshot
  body       String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, entityType, entityId])
}

/// A TMSA-style CAPA tracker row — polymorphic, so any module (Incident, NCR,
/// Audits, …) can attach a corrective/preventive action plan without its own
/// table. `code` is denormalized at creation time (e.g. "CA-01", "PA-03"),
/// numbered per (entityType, entityId, kind) starting at 01.
model CapaAction {
  id         String   @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  kind       CapaKind
  code       String // e.g. "CA-01" (corrective) or "PA-01" (preventive)

  action      String
  responsible String? // ownership — who is accountable
  targetDate  DateTime?
  status      CapaStatus @default(OPEN)
  closedDate  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, entityType, entityId, kind])
}

model Notification {
  id        String           @id @default(uuid())
  companyId String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ─── Workflow engine (configurable approval chains) ─────────────────────────────

/// A reusable approval-chain template bound to an entity type.
model WorkflowDefinition {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  key         String // e.g. "sms-document-approval"
  name        String
  entityType  String // which entity this workflow governs
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([companyId, key])
  @@index([companyId, entityType])
}

model WorkflowStep {
  id           String             @id @default(uuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  order        Int
  name         String // e.g. "Master Review"
  approverType ApproverType
  approverRole String? // role name when approverType = ROLE
  approverDept DepartmentType? // when approverType = DEPARTMENT
  approverUser String? // user id when approverType = SPECIFIC_USER
  slaHours     Int?

  actions WorkflowAction[]

  @@unique([definitionId, order])
}

/// A live run of a workflow against one concrete record.
model WorkflowInstance {
  id           String                 @id @default(uuid())
  companyId    String
  definitionId String
  definition   WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  entityType   String
  entityId     String
  status       WorkflowInstanceStatus @default(DRAFT)
  currentOrder Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions WorkflowAction[]

  @@index([companyId, entityType, entityId])
  @@index([companyId, status])
}

model WorkflowAction {
  id         String           @id @default(uuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId     String
  step       WorkflowStep     @relation(fields: [stepId], references: [id])
  actorId    String
  actorName  String
  decision   WorkflowDecision
  comment    String?
  createdAt  DateTime         @default(now())

  @@index([instanceId])
}

// ─── Phase 1 reference module: SMS Manual ───────────────────────────────────────
//  The SMS Manual is the governing document set. Every controlled document is
//  versioned via SmsRevision; the document's `currentRevisionId` points at the
//  approved, in-force revision. This module is the pattern all other Phase 1
//  modules copy: entity + revision history + workflow + attachments + audit.

model SmsDocument {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  code        String // controlled document code, e.g. "ADM-10"
  title       String
  description String?
  category    String // e.g. "Administration", "Marine", "Technical"
  department  DepartmentType
  status      DocumentStatus @default(DRAFT)

  ownerId String?
  owner   User?   @relation("DocumentOwner", fields: [ownerId], references: [id])

  // Optional vessel scope — null means fleet-wide / shore document.
  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  currentRevisionId String?      @unique
  currentRevision   SmsRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  revisions SmsRevision[] @relation("DocumentRevisions")

  @@unique([companyId, code])
  @@index([companyId, department])
  @@index([companyId, status])
}

model SmsRevision {
  id            String         @id @default(uuid())
  companyId     String
  documentId    String
  document      SmsDocument    @relation("DocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  revisionNo    Int
  changeSummary String?
  content       String? // markdown body (for text-authored procedures)
  fileKey       String? // Spaces key when the revision is an uploaded file
  status        DocumentStatus @default(DRAFT)
  effectiveDate DateTime?
  approvedBy    String?
  approvedAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  currentOf SmsDocument? @relation("CurrentRevision")

  @@unique([documentId, revisionNo])
  @@index([companyId, documentId])
}

// ─── Phase 1 module: Incident Management ────────────────────────────────────
//  Records shipboard/shore incidents and drives them through an investigation
//  lifecycle (REPORTED → UNDER_INVESTIGATION → ACTION_PENDING → CLOSED),
//  capturing root cause and corrective/preventive actions (CAPA). Built on the
//  same feature pattern as the SMS Manual module.

model Incident {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Null while status = DRAFT — assigned only once the report actually goes
  // out, so a draft that's abandoned/edited repeatedly never burns a
  // sequence number.
  refNo     String? // human reference, unique per company (e.g. INC-2026-0001)

  title    String
  severity Severity? // office-assessed, set during investigation — not by the reporter
  status   IncidentStatus @default(REPORTED)

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  occurredAt  DateTime
  location    String?
  description String

  // Type of incident (multi-select) — each tagged type carries its own
  // sub-category, captured as a child row (see IncidentTypeEntry).
  typeEntries IncidentTypeEntry[]

  // Investigation narrative — the office's OWN account of what happened,
  // written from the ECFA investigation (separate from `description`, which
  // is the vessel's initial report). Unset until investigation starts.
  investigationDetails String?

  // Root cause classification — unset on the initial report; the office fills
  // this in during investigation (ECFA), never at the moment of reporting.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts

  // Investigation (narrative). Corrective/preventive actions are tracked as
  // structured CapaAction rows (see below), not free text.
  immediateAction String?
  rootCause       String?
  closedAt        DateTime?

  // Management verification — closing IS the verification act in this SMS's
  // workflow (only users with incident:close hold that authority). WHO
  // verified is captured automatically from the session (never typed in, so
  // it can't be spoofed); WHEN is entered manually by that same person at the
  // moment of closing, since the actual verification may not be "right now".
  verifiedById   String?
  verifiedByName String?
  verifiedAt     DateTime?

  reportedById     String?
  reportedBy       User?   @relation("IncidentReporter", fields: [reportedById], references: [id])
  // Manual — the vessel shares just 2 logins (Master + one Crew account used
  // by whoever is encoding), so the logged-in account does not reliably
  // identify the actual individual reporter. Typed in on the report form.
  reporterName     String?
  reporterPosition String?

  sofEntries IncidentSofEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([companyId, vesselId])
  @@index([companyId, occurredAt])
}

// Statement of Facts — chronological timeline of events/response actions,
// captured as part of the initial report (distinct from the free-text
// `description` summary). Time is kept as free text (e.g. "0840 LT") since
// that's how these are written on paper/PDF incident reports.
model IncidentSofEntry {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  time       String
  event      String
  order      Int
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// One row per Type of incident tagged on the report — each carries its own
// sub-category (the allowed sub-category values per type are app-defined in
// features/incidents/schema.ts, not enforced at the DB level, since each of
// the 13 types has a different sub-category list).
model IncidentTypeEntry {
  id          String       @id @default(uuid())
  incidentId  String
  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        IncidentType
  subCategory String
  order       Int
  createdAt   DateTime     @default(now())

  @@index([incidentId])
}

// ─── Phase 1 module: Near Miss ──────────────────────────────────────────────
//  A near miss had the potential to cause harm but did not — nothing actually
//  happened, so only potential severity is captured (no "actual severity").

model NearMiss {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Null while status = DRAFT — assigned only once the vessel reports it, so
  // a draft that's abandoned/edited repeatedly never burns a sequence number.
  refNo     String?

  title                  String
  // Near Miss vs Hazard Observation (HOR) — one merged report; a HOR
  // additionally carries horCategory (Unsafe Act / Unsafe Condition).
  kind                   NearMissKind @default(NEAR_MISS)
  horCategory            HazardType? // set only when kind = HOR
  stopAuthorityExercised Boolean      @default(false) // Stop Work Authority — HOR only; feeds future stop-card counts per reporter
  vesselId               String?
  vessel                 Vessel?      @relation(fields: [vesselId], references: [id])
  occurredAt             DateTime
  location               String?
  description            String

  potentialConsequence NearMissConsequenceType
  potentialSeverity    Severity
  immediateAction      String?

  // Root cause — captured in the same report, by the same reporter (no
  // separate office-investigation phase like Incidents). Corrective actions
  // are tracked as structured CapaAction rows (see CAPA REGISTRY), not free
  // text.
  rootCauseCategory    RootCauseCategory
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts

  status   NearMissStatus @default(REPORTED)
  closedAt DateTime?

  // Office review — the office's oversight comment, separate from the
  // vessel-owned report + corrective actions above. No CAPA duplication
  // here; the vessel already tracks/monitors that in their own section.
  // reviewedAt is entered manually by the reviewer, not auto-captured.
  // Named `shoreRemarks` app-wide (see COMMENTS_STANDARDIZATION_REPORT.md) —
  // was `companyComments` prior to that standardization pass.
  shoreRemarks String?
  reviewedAt   DateTime?

  reportedById     String?
  reportedBy       User?   @relation("NearMissReporter", fields: [reportedById], references: [id])
  // Manual — the vessel shares just 2 logins (Master + one Crew account used
  // by whoever is encoding), so the logged-in account does not reliably
  // identify the actual individual reporter. Typed in on the report form.
  reporterName     String?
  reporterPosition String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, kind])
}

// ─── Phase 1 module: Non-Conformity (NCR) ───────────────────────────────────
//  A finding that a requirement (SMS clause, regulation, standard) is not met.
//  Raised from audits/inspections; closed after corrective action is verified.

model NonConformity {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String? // null while status = DRAFT — assigned only once actually raised

  title          String
  vesselId       String?
  vessel         Vessel?   @relation(fields: [vesselId], references: [id])
  source         NcrSource
  // Soft link to the specific finding/deficiency row that raised this NCR
  // (PscDeficiency / InternalAuditFinding / ExternalAuditFinding, etc. —
  // which table depends on `source`). One finding = one NCR; no enforced FK
  // since each source type lives in a different table (same pattern as
  // CapaAction.entityId).
  sourceEntityId String?
  requirement    String // the clause / requirement that is breached
  description    String
  severity       Severity
  raisedAt       DateTime
  targetDate     DateTime?

  // Root cause classification — shared taxonomy with Incident/Near Miss (see
  // lib/root-cause.ts). Filled in by office during CAPA review, not at raise
  // time. Corrective actions themselves live in CapaAction (entityType
  // "NonConformity"), not on this row — same shared tracker Incident/Near
  // Miss use, so "add another corrective action" is already supported.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  // Single owner of the corrective action — a person (by title/rank) or a
  // whole department; office NCRs are often owned by a department, not one
  // named individual.
  personInCharge       String?

  // Office's written reply on this NCR — same app-wide "shore feedback on a
  // vessel/office-raised report" field as NearMiss.shoreRemarks and
  // CommitteeMeeting.shoreRemarks (see COMMENTS_STANDARDIZATION_REPORT.md).
  // NCR has no ship/office permission split elsewhere in this module, so
  // this is gated by the same ncr:update permission as root cause, not a
  // separate office-only key.
  shoreRemarks String?

  status   NcrStatus @default(OPEN)
  closedAt DateTime?

  raisedById String?
  raisedBy   User?   @relation("NcrRaisedBy", fields: [raisedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
}

// ─── Phase 1 module: SIRE Inspection (OCIMF tanker vetting) ──────────────────

model SireInspection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  inspectingCompany String // OCIMF operator / oil major that vetted
  inspectorName     String
  port              String?
  inspectionDate    DateTime
  inspectionType    SireInspectionType?
  sireVersion       String?
  overallResult     SireOverallResult?
  summary           String? // "Remarks" in the UI

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  observations SireObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId])
  @@index([companyId, inspectionDate])
}

model SireObservation {
  id           String         @id @default(uuid())
  companyId    String
  inspectionId String
  inspection   SireInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Stable per-inspection ordinal for "Observation No. N" — assigned once at
  // creation, so it doesn't shift if an earlier observation is later deleted.
  seq         Int
  chapter     Int? // OCIMF VIQ chapter, 1–13
  category    SireObservationCategory?
  viqRef      String? // Question number, e.g. "3.5.1"
  question    String? // the VIQ question text, for reference
  observation String // Finding / Inspector Observation

  immediateCause       String?
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  correctiveAction     String?
  preventiveMeasure    String?

  responsiblePersonId  String?
  responsiblePerson    User?     @relation("SireObservationResponsible", fields: [responsiblePersonId], references: [id])
  targetDate           DateTime?
  actualCompletionDate DateTime?

  status SireObservationStatus @default(OPEN)

  verifiedById String?
  verifiedBy   User?   @relation("SireObservationVerifier", fields: [verifiedById], references: [id])

  comments SireObservationComment[]

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

model SireObservationComment {
  id            String          @id @default(uuid())
  companyId     String
  observationId String
  observation   SireObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?           @relation("SireObservationCommentAuthor", fields: [authorId], references: [id])
  body          String

  createdAt DateTime @default(now())

  @@index([observationId])
}

// SIRE 2.0's own VIQ (Vessel Inspection Questionnaire) gets revised by OCIMF
// periodically, so this is uploaded reference data rather than a hardcoded
// list — office uploads a new spreadsheet version when SIRE updates, and the
// most recent one supersedes the last (see features/sire-questionnaire). Only
// used today to power a "suggest the VIQ chapter/question number" hint on
// Company Inspection observations — the Supt drafting an internal inspection
// doesn't always know the exact SIRE 2.0 reference offhand, unlike an actual
// SIRE inspector recording an official vetting.
model SireQuestionnaireVersion {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label String // e.g. the uploaded filename, or a typed label
  // Exactly one active version per company at a time — enforced in
  // features/sire-questionnaire/actions.ts (deactivate-then-activate in a
  // transaction), not a DB constraint, matching how "current revision"
  // singleton state is handled elsewhere in this app (e.g. RiskAssessmentDocument).
  isActive  Boolean @default(false)
  itemCount Int     @default(0)

  items SireQuestionnaireItem[]

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, isActive])
}

model SireQuestionnaireItem {
  id        String                   @id @default(uuid())
  companyId String
  versionId String
  version   SireQuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  chapter        Int // derived from the leading number in `no` (e.g. "4.2.3" -> 4)
  no             String // VIQ question number, e.g. "4.2.3"
  question       String  @db.Text
  shortText      String?
  personInCharge String?
  smsProcRefs    String? // company SMS procedures this question maps to

  createdAt DateTime @default(now())

  @@index([companyId, versionId])
  @@index([companyId, versionId, chapter])
}

// ─── Phase 1 module: PSC Inspection (Port State Control) ─────────────────────

model PscInspection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  authority      String // port state authority
  mouRegion      String? // e.g. Tokyo MOU, Paris MOU, USCG
  port           String?
  inspectionDate DateTime
  detained       Boolean  @default(false)
  summary        String?

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  deficiencies PscDeficiency[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId])
  @@index([companyId, inspectionDate])
}

model PscDeficiency {
  id                   String             @id @default(uuid())
  companyId            String
  inspectionId         String
  inspection           PscInspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  natureCode           String? // PSC nature-of-deficiency code
  reference            String? // convention reference (e.g. SOLAS III/19)
  description          String
  actionCode           String? // PSC action code, e.g. 17 (rectify), 30 (detainable)
  // Root cause classification — same shared taxonomy as Incident/Near
  // Miss/NCR (lib/root-cause.ts). Corrective actions themselves live in
  // CapaAction (entityType "PscDeficiency"), replacing the old free-text
  // rectification field with the same tracker used company-wide.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  // Resolved status is derived from its linked CapaAction rows (all Closed =
  // rectified), not stored — a manual flag here could drift out of sync with
  // the actual corrective actions, which is exactly what caused inspections
  // to close with CAPA items still open. See closePscAction.

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

// ─── Phase 1 module: CDI Inspection (Chemical Distribution Institute) ────────

model CdiInspection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  inspectorName  String?
  scheme         String?  @default("CDI-M") // CDI-M (marine)
  port           String?
  inspectionDate DateTime
  summary        String?

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  observations CdiObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
}

model CdiObservation {
  id           String        @id @default(uuid())
  companyId    String
  inspectionId String
  inspection   CdiInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  questionRef  String? // CDI question reference
  observation  String
  response     String?
  status       FindingStatus @default(OPEN)

  // category is the CDI checklist section (1–14, 5LP for LPG cargo ops).
  // Root-cause taxonomy still mirrors SIRE, so both feed the same KPI shape.
  category             CdiObservationSection?
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

// ─── Phase 1 modules: Internal & External Audits ────────────────────────────
//  Two separate modules with an identical structure: an audit header plus a
//  list of findings graded Major NC / Minor NC / Observation. The audit closes
//  only once every finding is closed.

model InternalAudit {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String? // null while status = DRAFT — assigned only once actually raised

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  scope       String // what was audited, e.g. "Full SMS", "Navigation"
  standard    String // ISM, ISO 9001, TMSA, MLC, …
  auditorName String? // lead auditor
  auditBody   String? // department / team (kept for structural parity)
  auditDate   DateTime
  summary     String?

  status   InternalAuditStatus @default(OPEN)
  closedAt DateTime?

  findings InternalAuditFinding[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId])
  @@index([companyId, auditDate])
}

model InternalAuditFinding {
  id                   String               @id @default(uuid())
  companyId            String
  auditId              String
  audit                InternalAudit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category             AuditFindingCategory
  reference            String? // clause / requirement
  description          String
  // Root cause classification — same shared taxonomy as Incident/Near
  // Miss/NCR/PSC (lib/root-cause.ts). Corrective actions live in CapaAction
  // (entityType "InternalAuditFinding"), replacing the old free-text
  // correctiveAction field with the same tracker used company-wide.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  // Resolved status is derived from its linked CapaAction rows (all Closed =
  // resolved), not stored — a manual flag here could drift out of sync with
  // the actual corrective actions. See closeInternalAuditAction / closeExternalAuditAction.

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([auditId])
}

model ExternalAudit {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  scope       String
  standard    String
  auditorName String? // lead external auditor
  auditBody   String? // certifying / verification body (RO, class, flag)
  auditDate   DateTime
  summary     String?

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  findings ExternalAuditFinding[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId])
  @@index([companyId, auditDate])
}

model ExternalAuditFinding {
  id                   String               @id @default(uuid())
  companyId            String
  auditId              String
  audit                ExternalAudit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category             AuditFindingCategory
  reference            String?
  description          String
  // Root cause classification — same shared taxonomy as Incident/Near
  // Miss/NCR/PSC (lib/root-cause.ts). Corrective actions live in CapaAction
  // (entityType "ExternalAuditFinding"), replacing the old free-text
  // correctiveAction field with the same tracker used company-wide.
  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description
  // Resolved status is derived from its linked CapaAction rows (all Closed =
  // resolved), not stored — a manual flag here could drift out of sync with
  // the actual corrective actions. See closeInternalAuditAction / closeExternalAuditAction.

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([auditId])
}

// Company-conducted inspections (superintendent visits, internal vetting-style
// checks) — same OPEN/IN_PROGRESS/CLOSED lifecycle as SIRE, but each
// observation is deliberately lean: Observation + Root Cause + an on-the-spot
// Immediate Corrective Action, with any longer-running follow-up tracked in
// the shared CAPA register (CapaAction, entityType "CompanyInspectionObservation")
// instead of SIRE's fuller responsible-person/target-date/verification fields.
model CompanyInspection {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  // Which discipline the inspection covers — Technical (machinery, equipment
  // condition) vs Safety (procedures, PPE, safe working practices).
  inspectionType CompanyInspectionType?

  // Port Visit (alongside/berth) vs Sailing Visit (underway) — replaces the
  // earlier SIRE-style overall result, which didn't fit how these
  // company-conducted inspections are actually classified.
  visitKind CompanyInspectionVisitKind?

  inspectorName  String?
  port           String?
  inspectionDate DateTime
  summary        String?

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  observations CompanyInspectionObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId])
  @@index([companyId, inspectionDate])
}

model CompanyInspectionObservation {
  id           String            @id @default(uuid())
  companyId    String
  inspectionId String
  inspection   CompanyInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  // Stable per-inspection ordinal for "Observation No. N", same as SireObservation.seq.
  seq         Int
  chapter     Int? // VIQ_CHAPTERS in features/sire/schema.ts — reused as-is
  category    SireObservationCategory?
  viqRef      String? // "Question number", e.g. "3.5.1"
  observation String // "Finding / Inspector observation" in the UI
  immediateCause String?

  rootCauseCategory    RootCauseCategory?
  rootCauseSubCategory String? // one flat sub-cause per category — see lib/root-cause.ts
  rootCause            String? // free-text root cause description

  immediateCorrectiveAction String? // fixed on the spot, distinct from the CAPA follow-up

  createdAt DateTime  @default(now())
  createdBy String?
  deletedAt DateTime?

  @@index([inspectionId])
}

// ─── Exposure Hours module — continuous crew-hours ledger + injury cases ────
//  Total exposure hours are never manually entered. Each vessel keeps a
//  running crew-count history (ExposureCrewEntry) — one row per crew-count
//  change and the date it took effect — and total hours for any date range
//  is computed as crew × 24h/day integrated across that history, live, up
//  to today. Injury cases are logged independently, each tagged with the
//  date it occurred; LTI/TRC/LTIF/TRCF are derived from them, never stored.
//  See features/exposure-hours/schema.ts for the shared formula/computation
//  helpers.
enum ExposureEnteredBy {
  VESSEL
  OFFICE
}

model ExposureCrewEntry {
  id        String @id @default(uuid())
  companyId String
  vesselId  String

  crew          Int
  effectiveFrom DateTime // this crew count applies from this date onward, until the next entry

  enteredBy ExposureEnteredBy

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, vesselId, effectiveFrom])
}

// One row per recordable injury/case, classified under its single, final,
// most-serious outcome (see the hierarchy below) — never split across
// multiple categories as it evolves.
//   FAT > PTD > PPD > LWC > RWC > MTC > FAC (not recordable)
enum InjuryClassification {
  FAC
  MTC
  RWC
  LWC
  PPD
  PTD
  FAT
}

model ExposureInjuryCase {
  id        String @id @default(uuid())
  companyId String
  vesselId  String

  classification InjuryClassification
  description    String?
  occurredOn     DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, vesselId, occurredOn])
}

// ─── Phase 1 module: Committee Meetings (ADM-04 / RC-013) ─────────────────────
//  A vessel's monthly committee meeting(s) per ADM-04 — Safety, Maintenance,
//  Health & Hygiene, and Shipboard Management Team each have their own fixed
//  agenda template (see lib in features/committee-meetings/schema.ts); a
//  single meeting instance can combine several committee types at once (the
//  "type of meeting" shown to the user is simply the distinct set of
//  committeeType values across its agenda items). OTHERS covers ad hoc /
//  extraordinary meetings with no fixed template — their agenda items are
//  freely authored (custom label) rather than pulled from AGENDA_TEMPLATES.
enum CommitteeType {
  SAFETY
  MAINTENANCE
  HEALTH_HYGIENE
  SHIPBOARD_MANAGEMENT_TEAM
  OTHERS
}

enum CommitteeMeetingStatus {
  DRAFT
  REPORTED
  CLOSED
}

model CommitteeMeeting {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Null while status = DRAFT — assigned once on the first "Report Meeting"
  // and never reassigned again, even across a later revert-and-resend cycle.
  refNo     String?

  vesselId String? // null = shore/office-originated record
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  position    String? // vessel's location at time of meeting, e.g. "TEMA, GHANA - ANCHORAGE"
  meetingDate DateTime
  meetingTime String? // free text — often a range, e.g. "1100H-1130"

  chairman     String?
  inCharge     String?
  members      String? // free text, one per line
  inAttendance String? // free text, one per line

  // Crew who could not attend and must acknowledge the minutes separately.
  forAcknowledgement String?

  vesselRemarks String? // Master's overall closing remarks
  shoreRemarks  String? // office's overall reply — required before Close

  status             CommitteeMeetingStatus @default(DRAFT)
  reportedAt         DateTime? // set (and refreshed) every time the vessel reports
  closedAt           DateTime? // set when the office closes it out
  // True the moment the vessel edits+re-reports a meeting the office has
  // already closed once — cleared when the office closes it again. Lets the
  // office notice "the vessel changed something since I last reviewed this"
  // without losing the shoreRemarks/agenda shoreComments already on file.
  revisedAfterReview Boolean                @default(false)

  agendaItems CommitteeMeetingAgenda[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, vesselId])
}

model CommitteeMeetingAgenda {
  id        String           @id @default(uuid())
  companyId String
  meetingId String
  meeting   CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Stable ordinal for numbering ("1", "2", "3"…) — assigned once at
  // creation, so it doesn't shift if an earlier item is later deleted.
  seq           Int
  committeeType CommitteeType
  code          String? // "A", "B"… for fixed-template items; null for ad hoc Others topics
  label         String // full agenda line text
  details       String? // discussion details, filled in by the vessel
  shoreComments String? // office's per-item reply, once reviewed

  createdAt DateTime @default(now())

  @@index([meetingId])
}

// ─── Phase 1 module: Emergency Drills & Familiarization ───────────────────────
//  ScheduleItem is the master checklist — one row per required drill (from
//  SMS procedure A-EMP-01) or familiarization topic (from CK-047(b)), each
//  with its required frequency. EmergencyDrill and FamiliarizationRecord are
//  the actual logged completions against those items; the compliance matrix
//  (Last/Next due + month grid, per SMS-EMP-01 layout) is computed from them
//  at read time in features/schedule/queries.ts rather than stored.

enum ScheduleItemKind {
  DRILL
  FAMILIARIZATION
}

model ScheduleItem {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  kind      ScheduleItemKind

  // Section heading as printed on the SMS form — "STATUTORY DRILLS",
  // "NON-STATUTORY DRILL", "TRAINING" (drills); null for familiarization,
  // which has a single flat list.
  category       String?
  // Display numbering as printed, e.g. "1.0", "2.3" — informational only,
  // not used for sorting (sortOrder is).
  itemNo         String?
  name           String
  smsReference   String?
  // Required interval, both as printed ("Once in 3 months") and parsed to
  // days for due-date math. frequencyDays is null for irregular items
  // ("as required/applicable") — those never show an overdue status.
  frequencyLabel String?
  frequencyDays  Int?
  sortOrder      Int
  active         Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  drills           EmergencyDrill[]
  familiarizations FamiliarizationRecord[]
  exceptions       ScheduleApplicability[]

  @@unique([companyId, kind, itemNo])
  @@index([companyId, kind, sortOrder])
}

// Per-vessel override marking a checklist item as not applicable to that
// specific ship (e.g. a Free Fall Lifeboat drill on a vessel with
// conventional lifeboats only, or "if applicable" familiarization topics
// like VGP/Biofouling) — several source-form items are explicitly qualified
// this way ("only for vessel provided with one liferaft", "if applicable").
// Only "not applicable" rows are stored; a missing row means the item is
// applicable (the default) — office-managed, since it's a vessel-equipment
// fact, not something the ship should toggle unilaterally.
model ScheduleApplicability {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id])

  notApplicable Boolean @default(true)
  reason        String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([companyId, vesselId, scheduleItemId])
}

model EmergencyDrill {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String? // null while status = DRAFT — assigned only once actually recorded

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id])

  // Fields mirror SMS form R-AS-021 "Report of Drill / Training onboard"
  // (Appendix 6) — the vessel's actual paper/PDF report.
  drillDate        DateTime
  drillTime        String? // as printed, e.g. "1000H-1030H" — a range, not parsed
  position         String? // ship's position/location during the drill
  participants     String? // "Ranks of Crew Participated"
  conductedBy      String? // Master's name
  details          String? // "Details of Drill / Training" — full narrative
  deficiencies     String? // "Found Deficiencies"
  correctiveAction String? // "Master's Opinion for Improvement and Corrective Action"
  vesselRemarks    String?

  status   DrillStatus @default(OPEN)
  closedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, vesselId, scheduleItemId])
}

// Vessel-level familiarization log (CK-047(b)) — same shape/purpose as
// EmergencyDrill but for familiarization topics rather than drills; kept as
// a separate model since the two are logged and reviewed independently even
// though they share the same ScheduleItem + matrix machinery.
model FamiliarizationRecord {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id])

  completedDate DateTime
  notedBy       String?
  remarks       String?

  // The logging session this completion belongs to — one session covers several
  // topics at once and is shown as a single drill-style record.
  familiarizationSessionId String?
  familiarizationSession   FamiliarizationSession? @relation(fields: [familiarizationSessionId], references: [id])

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, vesselId, scheduleItemId])
}

// One "Log Familiarization" session (CK-047(b)) = one drill-style record, the
// same format as an Emergency Drill / LSA-FFE record. It covers whichever SMS
// topics were touched that sitting (each a FamiliarizationRecord linked here).
model FamiliarizationSession {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  sessionDate DateTime
  notedBy     String?
  remarks     String?

  records FamiliarizationRecord[]

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, vesselId])
}

// LSA/FFE familiarization checklist (CK-047(a)) — distinct from the
// vessel-level ScheduleItem/matrix machinery above: this tracks a group
// induction session's coverage of every Life Saving Appliance and Fire
// Fighting Equipment item, per SMS TRN-10 4.3(5) ("Training on all the
// Ship's LSA and FFE shall be covered within any period of 2 months").
// LsaFfeItem is the fixed 55-item catalog (29 LSA + 26 FFE, transcribed
// verbatim from the form); CrewFamiliarization is one 8-week induction
// cycle for whichever crew attend (free-text `attendees`, not one row per
// person); CrewFamiliarizationRecord marks the date each item was actually
// covered in that cycle (absence = not yet done).
enum LsaFfeCategory {
  LSA
  FFE
}

model LsaFfeItem {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  category      LsaFfeCategory
  itemNo        Int
  name          String
  active        Boolean        @default(true)
  // Which week (1-8) of the 2-month TRN-10 4.3(5) cycle this item is
  // suggested for — a pacing guide only, not enforced. Every item still
  // just needs a completedDate somewhere within the 8-week cycle.
  suggestedWeek Int            @default(1)

  records CrewFamiliarizationRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, category, itemNo])
  @@index([companyId, category])
}

model CrewFamiliarization {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  // Free text, not a single crew member — this induction is conducted as a
  // group session that whichever crew need it attend, not filed one form
  // per individual.
  // One familiarization session = one record, exactly like an Emergency Drill
  // record. `week` is which week of the 8-week LSA/FFE schedule this session
  // covered; `cycleStartDate` is the date the familiarization was carried out;
  // attendees are whoever was available that session.
  week           Int      @default(1)
  attendees      String
  cycleStartDate DateTime
  supervisedBy   String?
  details        String? // free-text "Details of familiarization" for the session

  records CrewFamiliarizationRecord[]

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, vesselId])
}

model CrewFamiliarizationRecord {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  crewFamiliarizationId String
  crewFamiliarization   CrewFamiliarization @relation(fields: [crewFamiliarizationId], references: [id])

  lsaFfeItemId String
  lsaFfeItem   LsaFfeItem @relation(fields: [lsaFfeItemId], references: [id])

  completedDate DateTime

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([crewFamiliarizationId, lsaFfeItemId])
}

// ─── Phase 1 module: Controlled Documents ─────────────────────────────────────

enum DocumentCategory {
  FORM
  CHECKLIST
  CERTIFICATE
  MANUAL
  PROCEDURE
  OTHER
}

enum ControlledDocStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model ControlledDocument {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  docNumber String

  vesselId String? // null = fleet-wide document
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  title       String
  category    DocumentCategory
  version     String?
  issueDate   DateTime
  reviewDate  DateTime?
  owner       String? // issuing department / role
  description String?

  status ControlledDocStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, docNumber])
  @@index([companyId, status])
}

// Certificate/document register — statutory certs, class certs, insurance,
// etc., tracked for expiry (Vessel Documentation / Company Documents pages).
// Distinct from ControlledDocument above, which is the SMS procedure
// library, not a certificate expiry tracker.
model VesselDocument {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // null = Company Documents (Origin: COMPANY); set = Vessel Documentation
  // (Origin: VESSEL) — same nullable-vesselId convention as ControlledDocument.
  vesselId String?
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  // Free text, not an enum — Vessel Documentation's UI offers a fixed
  // 8-category list (Ship Information, Flag Certificates, ...); Company
  // Documents has no fixed list yet, so its filter is built from whatever
  // types are actually in use.
  type String

  // Source-register sequence code, e.g. "101.03" — informational only, not
  // unique/required (unlike other modules' refNo, this isn't a generated ID).
  refNo String?

  name        String
  issuingBody String?
  certNo      String?
  // Printed renewal interval, e.g. "5Y", "1Y", "3M", "as needed" — display
  // only, not used for due-date math (unlike ScheduleItem.frequencyDays).
  interval    String?
  issuedDate  DateTime?
  expiredDate DateTime?
  remarks     String?

  // Power-icon toggle in the register — an inactive document (e.g.
  // superseded, or the vessel changed flag/class) is kept on file but
  // excluded from the Expiring/Expired counts.
  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, vesselId])
  @@index([companyId, type])
}

// ─── Phase 1 module: Circulars ────────────────────────────────────────────────

// Who issued it — a separate facet from `category` (what it's about) below.
// Flag/Class/Insurance circulars still carry a subject (a Panama circular can
// still be about Safety), so the two facets are independent, not nested.
enum CircularSource {
  FLAG
  CLASS
  INSURANCE
  COMPANY
}

enum CircularCategory {
  SAFETY
  TECHNICAL
  NAVIGATIONAL
  SECURITY
  ENVIRONMENTAL
  SAFETY_CAMPAIGN
  HEALTH_HYGIENE
  OPERATIONAL
  HR
  REGULATORY
  OTHER
}

model Circular {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String? // null = fleet-wide circular
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  title        String
  source       CircularSource
  // Free text, not an enum — the set of flag states / class societies a
  // fleet deals with grows over time (today: Panama, Singapore, Malaysia,
  // Marshall Islands, Malta for FLAG; NKK, BV for CLASS). Not applicable
  // when source = COMPANY. features/circulars/schema.ts suggests common
  // values per source without locking the field to them.
  issuingBody  String?
  category     CircularCategory
  issueDate    DateTime // when the source actually issued it
  // When the company logged/received it — separate from issueDate because
  // the whole point of this field is catching the "we have no record of
  // when this actually arrived" gap in the old manual process.
  dateReceived DateTime?
  body         String

  acknowledgements CircularAcknowledgement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, source])
  @@index([companyId, category])
}

/// One row per recipient who must acknowledge a circular — replaces "emailed
/// it, but nobody reads email" with an in-app pending/acknowledged status per
/// recipient. Recipients are computed once at creation time (see
/// createCircularAction): every targeted vessel gets a row (any shipboard
/// user aboard may acknowledge on its behalf), plus one row per named office
/// user explicitly selected to be tracked (e.g. the Superintendent).
///
/// Same entity-agnostic soft-reference pattern as Attachment/CapaAction
/// (recipientType + recipientId, no FK) rather than two nullable typed
/// relations — avoids adding back-relation arrays to Vessel/User for what is
/// a peripheral tracking table, and keeps this consistent with how the rest
/// of the app models "attaches to one of several possible parent shapes."
model CircularAcknowledgement {
  id         String   @id @default(uuid())
  companyId  String
  circularId String
  circular   Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)

  recipientType  String // "VESSEL" | "USER"
  recipientId    String
  recipientLabel String // denormalized snapshot — vessel name or user full name, so the ack list renders with no extra join

  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedByName String?

  createdAt DateTime @default(now())

  @@unique([circularId, recipientType, recipientId])
  @@index([companyId, recipientType, recipientId])
}

// ─── Phase 1 module: Risk Assessments ─────────────────────────────────────────
//  Controlled-document library for Risk Assessments (ISM / SIRE 2.0 / TMSA 3
//  aligned). Mirrors the SmsDocument/SmsRevision pattern: a master document
//  holds identity + review scheduling, a separate immutable revision table
//  holds versioned content, and approval runs through the shared workflow
//  engine. Two additional entities layer on top: RiskAssessmentExecution (the
//  crew's per-job "permit" — pins to a frozen revisionId, never the mutable
//  master) and RiskAssessmentRevisionRequest (crew-raised change proposals
//  that, if approved, spawn a new draft revision).

/**
 * Why a review/revision was triggered — a manual dropdown in Phase 1 (no
 * automatic cross-module hooks yet; see docs/ARCHITECTURE.md).
 */
enum ReviewTrigger {
  ANNUAL_REVIEW_DUE
  REVIEW_PERIOD_EXPIRED
  REVISION_REQUESTED_BY_VESSEL
  INCIDENT_INVESTIGATION_RECOMMENDATION
  NEAR_MISS_RECOMMENDATION
  HAZARD_OBSERVATION_RECOMMENDATION
  SIRE_OBSERVATION
  PSC_DEFICIENCY
  INTERNAL_AUDIT_FINDING
  EXTERNAL_AUDIT_FINDING
  SMS_PROCEDURE_REVISED
  MANAGEMENT_REQUEST
  REGULATORY_CHANGE
}

enum RaExecutionCondition {
  UNCHANGED
  CHANGED
}

enum RaRevisionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Entity type key used to bind Risk Assessment documents to the workflow engine.
 */
model RiskAssessmentDocument {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  refNo       String // RA-2026-0001
  title       String
  category    String // e.g. "Deck Operations", "Engine Room", "Cargo Operations"
  description String?

  vesselId             String? // null = fleet-wide
  vessel               Vessel? @relation("RaDocumentVessel", fields: [vesselId], references: [id])
  applicableVesselType String? // free-text tag (mirrors Vessel.type); null = all types

  reviewFrequencyMonths Int       @default(12)
  lastReviewDate        DateTime?
  nextReviewDate        DateTime?
  reviewOwnerId         String?

  status  DocumentStatus @default(DRAFT)
  ownerId String?

  currentRevisionId String?                 @unique
  currentRevision   RiskAssessmentRevision? @relation("RaCurrentRevision", fields: [currentRevisionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  revisions        RiskAssessmentRevision[]        @relation("RaDocumentRevisions")
  executions       RiskAssessmentExecution[]
  revisionRequests RiskAssessmentRevisionRequest[]

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([companyId, nextReviewDate])
}

/**
 * Office/Company approval requirement — mirrors the real RC-012 form's
 * "Approved By" classification (e.g. Hot Work inside the ER workshop needs
 * only local/SMC sign-off; outside the workshop needs mandatory Company
 * approval with a lead-time submission). Informational/display-only in this
 * phase — routing itself still goes through the single admin-configured
 * workflow chain at Settings → Workflows.
 */
enum RaApprovalLevel {
  LOCAL
  COMPANY_MANDATORY
}

model RiskAssessmentRevision {
  id            String                 @id @default(uuid())
  companyId     String
  documentId    String
  document      RiskAssessmentDocument @relation("RaDocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  revisionNo    Int
  changeSummary String?
  reviewTrigger ReviewTrigger?

  smsProcedureRefs   String? // e.g. "SSP-11 (Rev.4), SSP-13 (Rev.12), SSP-03"
  riskMatrixRef      String? // e.g. "SSP-13 / Appendix 13 — RF = Severity × Likelihood"
  checklistsRequired String? // e.g. "CK-003 (Hot Work Permit) — MANDATORY"
  approvalLevel      RaApprovalLevel @default(LOCAL)

  status        DocumentStatus @default(DRAFT)
  effectiveDate DateTime?
  approvedBy    String?
  approvedAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  currentOf  RiskAssessmentDocument?   @relation("RaCurrentRevision")
  executions RiskAssessmentExecution[]
  hazardRows RiskHazardRow[]

  @@unique([documentId, revisionNo])
  @@index([companyId, documentId])
}

/**
 * One hazard line in the RA's hazard table — mirrors the real RC-012 form's
 * row shape exactly (Unwanted Consequence / Possible Causes / S / L / RF /
 * Existing Controls / Additional Controls / Residual S,L,RF / Responsible).
 * Per company policy (SSP-13 Sec. 5.7), residual Severity is always the same
 * as initial Severity — only Likelihood is re-rated after controls — so only
 * `resLikelihood` is stored; residual severity/RF are derived in app code.
 */
model RiskHazardRow {
  id         String                 @id @default(uuid())
  companyId  String
  revisionId String
  revision   RiskAssessmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  rowNo      Int

  phase              String? // e.g. "PHASE 1 — PRE-WORK PREPARATION"
  consequence        String // Unwanted Consequence, e.g. "Fire / Explosion"
  causes             String // Possible Causes / Hazard Factors
  severity           Int // 1-5
  likelihood         Int // 1-5
  existingControls   String
  additionalControls String?
  resLikelihood      Int? // residual Likelihood after Additional Controls (1-5)
  responsible        String?

  isNew            Boolean @default(false) // ★ new hazard added in this revision
  ratingChangeNote String? // e.g. "S corrected 4→3 — rationale..."

  // null = fleet-wide master row (office-authored, part of the formal
  // revision). Set = a vessel-specific addendum added directly by that
  // vessel's own officers, without going through the office review flow —
  // visible only to that vessel and to office (for oversight), never to
  // other vessels, and never counted as part of the master hazard table.
  // Carried forward automatically when a new revision is created (see
  // createRevisionAction) since it hasn't been formally reviewed away yet.
  vesselId String?
  vessel   Vessel? @relation("RaHazardRowVessel", fields: [vesselId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index([companyId, revisionId, rowNo])
  @@index([companyId, vesselId])
}

/**
 * A crew "permit" — one execution of an approved RA against a specific job.
 * `revisionId` is a frozen pointer (never re-follows the master's current
 * revision), so audits can always answer "what RA was actually shown".
 */
model RiskAssessmentExecution {
  id         String                 @id @default(uuid())
  companyId  String
  documentId String
  document   RiskAssessmentDocument @relation(fields: [documentId], references: [id])
  revisionId String
  revision   RiskAssessmentRevision @relation(fields: [revisionId], references: [id])

  vesselId String
  vessel   Vessel @relation("RaExecutionVessel", fields: [vesselId], references: [id])
  jobName  String // the specific job/task this execution covers

  conditionStatus       RaExecutionCondition @default(UNCHANGED)
  changedConditionsNote String?
  temporaryHazards      String? // scoped to this execution only — never mutates the master
  temporaryControls     String?

  performedById    String?
  toolboxSignedAt  DateTime?
  toolboxAttendees String? // free-text list of attendee names/ranks

  executedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  createdBy  String?

  @@index([companyId, documentId])
  @@index([companyId, vesselId])
}

/**
 * Crew-raised proposal to change a Risk Assessment. Office decides; approval
 * auto-spawns a new draft revision pre-filled with the request context. Crew
 * never edits the master directly.
 */
model RiskAssessmentRevisionRequest {
  id         String                 @id @default(uuid())
  companyId  String
  documentId String
  document   RiskAssessmentDocument @relation(fields: [documentId], references: [id])

  requestedById String?
  vesselId      String?
  vessel        Vessel? @relation("RaRevisionRequestVessel", fields: [vesselId], references: [id])

  reason        String
  reviewTrigger ReviewTrigger @default(REVISION_REQUESTED_BY_VESSEL)

  status       RaRevisionRequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())

  @@index([companyId, documentId, status])
}

// ─── Phase 1 module: Defect List ──────────────────────────────────────────────

enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum DefectStatus {
  OPEN
  MONITORING
  RECTIFIED
  DEFERRED
}

model Defect {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  refNo     String

  vesselId String
  vessel   Vessel @relation(fields: [vesselId], references: [id])

  equipment               String // equipment / system affected
  description             String
  severity                DefectSeverity
  dateRaised              DateTime
  targetRectificationDate DateTime?
  actionTaken             String?
  raisedBy                String?

  status      DefectStatus @default(OPEN)
  rectifiedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
}

// ─── Vessel Tracker (daily voyage log) ────────────────────────────────────────
// Mirrors the "Voyage Input Data" sheet of the fleet's existing Voyage
// Analysis BTsolve Excel workbook — same fields, same order — so vessels
// filling this in aren't learning a new form, just moving the same daily
// entry online. VesselStatus is the one field with no direct Excel column:
// the office's own Vessel Tracker calendar dashboard needs it to pick the
// right day icon, so it's asked directly using the same everyday terms a
// deck officer already uses in noon reporting (not derived/guessed from the
// Excel's plain Underway/At Port split, which is too coarse for that).
enum VoyageReportType {
  DEPARTURE
  ARRIVAL
  NOON_AT_SEA
  IN_PORT
}

enum VesselTrackerStatus {
  SAILING
  DRIFTING
  SHELTERING
  ANCHORING
  IN_PORT
}

enum VesselLadenState {
  LADEN
  BALLAST
}

enum EngineOrder {
  NORMAL_STEAMING
  SLOW_STEAMING
  SUPER_SLOW_STEAMING
  FAST_STEAMING
}

model VoyageLog {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  date     DateTime // report date (calendar day this entry belongs to)
  voyageNo String?
  // No standalone "route" field — fromPort/nextPort below fully describe a
  // leg; routeLabel() in features/vessel-tracker/schema.ts derives a
  // display string from them wherever the old routeOrPort was shown.

  reportType   VoyageReportType
  vesselStatus VesselTrackerStatus
  ladenState   VesselLadenState
  engineOrder  EngineOrder? // not applicable while in port

  // Steaming Time / Port Stay are manual entries — the report's own Date +
  // Report Time is the single timestamp for this entry (no separate
  // From/To period range).
  steamingTimeHrs Float?
  obsSpeedKn      Float?
  meSpeedKn       Float?
  rpm             Float?
  slipPct         Float?
  beaufortScale   Int?
  portStayHrs     Float?
  totalPortStayHrs Float? // running total across every While-in-Port entry this voyage — same "voyage to date" treatment as totalSteamingTimeHrs
  offHireHrs      Float? // stays manual — a charter-party/commercial call, not inferable from vesselStatus

  // Total FO/DO (and their ROB) are derived at read time by summing the
  // per-grade `bunkers` ledger below, grouped by category — no longer
  // stored here. The old Boiler/M.E./A.E. breakdown was a duplicate of the
  // per-grade ledger that predated seeing the fleet's real report and has
  // been removed (v3 cleanup).

  // ─── Fields below mirror the fleet's actual daily "Vessel Tracker"
  // report (While in Port / Noon / Departure / Arrival) from btsolve.com —
  // free text where the source form itself is free text (e.g. Lat/Long in
  // DMS, ETB/ETC/ETD which are often "N/A"), typed fields where the source
  // is a real number. Per-grade bunker figures (HSFO/LSFO/HSDO/etc., each
  // with Previous/Consumed/Received/ROB) live in VoyageLogBunker below
  // instead of as flat columns here — a real ROB ledger, not a fixed set
  // of columns some vessels won't even carry (e.g. a vessel with no HSGO).
  fromPort        String? // port sailed from — the Arrival/Departure/Noon reports track this separately from "Port" (current location) and "Next Port"
  nextPort        String?
  course          String?
  zoneDescription String? // e.g. "-2"
  reportTimeLocal String? // e.g. "0800H" — the source form's own free-text time label; combined with `date` as this entry's one timestamp

  position String? // free text — DMS lat/long (e.g. "33° 57.75' S 25° 38.67' E") or a place name (e.g. "At Singapore anchorage")

  draftFwdM  Float?
  draftAftM  Float?
  draftMeanM Float?

  // Navigation/performance stats block — Arrival/Departure/Noon reports
  // only (a vessel alongside has nothing to log here), same fields the
  // office's own dashboard is likely already deriving informally from the
  // narrative SOF text — capturing them structured here instead.
  distanceRunNm          Float?
  totalDistanceRunNm     Float?
  dtgNextPortNm          Float? // Distance To Go
  totalSteamingTimeHrs   Float?
  distanceLogNm          Float?
  generalAvgSpeedKn      Float?
  engineDistanceNm       Float?
  totalEngineDistanceNm  Float?
  generalAvgEngineSpeedKn Float?
  weatherCondition       String?
  generalAvgSlipPct      Float?
  barometer              Float?
  exhaustTempUnit        String?
  exhaustGasTemp         String?

  etaNextPortDate DateTime?
  etaNextPortTime String?
  etaNextPortZd   String?

  cargoOnboard      String?
  cargoToDiscLoaded String?
  blQuantity        Float?
  // Free-text per-tank Bottom-Middle-Top readings, e.g. "TK1 - 14.8, 14.0,
  // 0.0 / TK2 - 17.1, 16.2, 18.5" — the real form flows this as one line
  // covering however many tanks a voyage has, not a fixed column count.
  cargoTemp String? @db.Text

  agentName    String?
  agentTel     String?
  agentFax     String?
  agentEmail   String?
  agentAddress String?

  deckDeptReport   String? @db.Text
  engineDeptReport String? @db.Text
  statementOfFacts String? @db.Text

  master        String?
  chiefEngineer String?

  remarks String? @db.Text

  bunkers VoyageLogBunker[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId, vesselId, date])
}

enum BunkerGrade {
  HSFO
  LSFO
  HSDO
  LSDO
  HSGO
  LSGO
  CYL_OIL
  MELO
  GELO
  FRESH_WATER
  FRESH_WATER_PRODUCTION
}

/// One row per bunker/oil/water grade per voyage log entry — Previous +
/// Received - Consumed = ROB, the same running ledger the daily report
/// itself tracks. A child table rather than flat columns because not every
/// vessel carries every grade (e.g. no HSGO), and it keeps VoyageLog from
/// growing an ever-wider fixed column set as grades get added.
model VoyageLogBunker {
  id          String      @id @default(uuid())
  companyId   String
  voyageLogId String
  voyageLog   VoyageLog   @relation(fields: [voyageLogId], references: [id], onDelete: Cascade)
  grade       BunkerGrade
  previous    Float?
  consumed    Float?
  received    Float?
  rob         Float?

  @@unique([voyageLogId, grade])
  @@index([companyId, voyageLogId])
}

// Monthly garbage disposal + oil/water discharge reporting per vessel — the
// fleet's own "GARBAGE Form" + "OIL Immision" Excel sheet, one row-set per
// vessel per month, brought into the ERP so it can be graphed on a KPI
// dashboard instead of eyeballed in a spreadsheet. Mirrors the VoyageLog/
// VoyageLogBunker parent+ledger pattern above.
enum GarbageCategory {
  PLASTICS
  FOOD_WASTES
  DOMESTIC_WASTES
  COOKING_OIL
  INCINERATOR_ASHES
  OPERATIONAL_WASTES
  ANIMAL_CARCASSES
  FISHING_GEAR
  E_WASTE
}

// Metrics that offer the crew a Unit choice at entry time (everything else
// below is always entered directly in its one fixed standard unit, same as
// before — no picker, no normalization step, kept as simple as the current
// form). Extend this list only when a category genuinely needs more than
// one input unit in practice.
enum UnitMasterMetric {
  SEWAGE
  CARGO
}

/** Controlled conversion-factor reference data — "Unit Master" per the
 * Environmental spec: an admin-managed table of (metric, unit) →
 * (standardUnit, factor), so a crew member can pick whatever unit they
 * actually measured in (e.g. Litres) and the software derives the
 * standardized figure (e.g. m³) FOR them — never the other way around.
 * `factor` converts 1 unit of `unit` into `standardUnit`. Not editable from
 * any normal data-entry screen — only from the admin-only Unit Master page. */
model UnitMaster {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  metric    UnitMasterMetric
  unit      String // e.g. "m3", "L", "MT", "CBM"
  unitLabel String // display label, e.g. "Litres (L)"

  standardUnit     String // fixed target unit for this metric — same value on every row sharing a metric, e.g. "m3" for SEWAGE
  toStandardFactor Float // multiply an entered quantity in `unit` by this to get the quantity in `standardUnit`
  isDefault        Boolean @default(false) // pre-selected in the entry form's Unit dropdown

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([companyId, metric, unit])
  @@index([companyId, metric])
}

// Office-editable reference data — the controlled option lists behind pickers
// that used to be hard-coded constants in feature schemas (e.g. Vessel
// Documentation's document-type dropdown). One row per option, scoped per
// company and per `listKey` (the registry key in lib/reference-registry.ts).
// When a company has zero rows for a key, readers fall back to the registry's
// built-in constant list, so a picker never renders empty. `isSystem` marks
// rows seeded from those constants — they are deactivated (active=false), not
// hard-deleted, to preserve the fallback parity guarantee.
model ReferenceListItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  listKey   String // registry key, e.g. "vessel-document-type"
  value     String // stored value written onto records (value == label for flat lists)
  label     String // display label shown in the picker
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  isSystem  Boolean @default(false) // seeded from a registry fallback constant

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, listKey, value])
  @@index([companyId, listKey])
}

model EnvironmentRecord {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  year  Int
  month Int // 1-12

  // Ballast Water — always entered directly in the standard unit (m³), no
  // per-entry unit picker.
  ballastWaterQuantity   Float? // m3
  ballastWaterOperations Int?
  ballastWaterMethod     String? // treatment / exchange method
  ballastWaterRemarks    String?

  // Sewage — split by disposal route (at sea vs a shore reception facility)
  // rather than one lump figure, since which route it went is exactly what
  // a MARPOL sewage record needs to show. Total Monthly Discharged is
  // NEVER stored — derived at read/display time as the sum of the two,
  // same "derive, don't store" convention as the Garbage ledger's Total
  // Garbage. The one MARPOL-waste category the crew may log in a unit
  // other than the standard, so the derived total also carries its
  // Unit-Master-normalized figure (see UnitMaster above).
  sewageDischargedAtSea       Float? // as entered, in sewageUnit
  sewageDischargedToFacility  Float? // as entered, in sewageUnit
  sewageUnit                  String? // UnitMaster.unit for metric SEWAGE — applies to both quantities above
  sewageQuantityNormalized    Float? // derived: (sewageDischargedAtSea + sewageDischargedToFacility) * matching UnitMaster.toStandardFactor, in sewageQuantityStandardUnit
  sewageQuantityStandardUnit  String? // UnitMaster.standardUnit at the time this was saved (e.g. "m3") — kept alongside the number so a later Unit Master edit can't silently reinterpret an old entry
  sewageReceptionFacility     String? // name/location of the facility sewageDischargedToFacility was landed at
  sewageRemarks                String?

  // Grey Water — always m³, no unit picker.
  greyWaterGenerated  Float?
  greyWaterDischarged Float?
  greyWaterRetained   Float? // retained / landed
  greyWaterRemarks    String?

  // Refrigerant Gas — always kg, no unit picker (kg IS the standard unit).
  refrigerantGasType        String?
  refrigerantEquipment      String?
  refrigerantAdded          Float? // added / charged
  refrigerantRecovered      Float?
  refrigerantDisposedAshore Float?
  refrigerantLeakage        Float? // leakage / loss
  refrigerantQuantityKg     Float?
  refrigerantRemarks        String?

  // Cargo — a denominator for management analytics ONLY, never treated as a
  // MARPOL waste quantity. Same Unit Master pattern as Sewage: gas carriers
  // routinely report in CBM at some ports and MT at others, and the
  // MT⇄CBM factor is cargo-density-specific, not a fixed physical constant
  // — so it's a controlled, admin-set factor rather than something this app
  // calculates itself.
  cargoLoaded                Float?
  cargoDischarged            Float?
  cargoType                  String?
  cargoUnit                  String? // UnitMaster.unit for metric CARGO — applies to both cargoLoaded and cargoDischarged
  cargoLoadedNormalized      Float? // derived, in cargoStandardUnit
  cargoDischargedNormalized  Float? // derived, in cargoStandardUnit
  cargoStandardUnit          String? // UnitMaster.standardUnit at time of save (e.g. "MT")
  cargoPort                  String?

  // Stern Tube / Lube Oil — always in the company's one chosen unit (set via
  // Unit Master's isDefault row for future use; entered plainly for now,
  // same as before this feature).
  lubeOilType        String?
  lubeOilAdded       Float? // quantity added
  lubeOilTransferred Float? // quantity transferred
  lubeOilLost        Float? // quantity lost / leakage, if applicable
  lubeOilEquipment   String?
  lubeOilRemarks     String?

  // Bilge — always m³, no unit picker.
  bilgeGenerated     Float?
  bilgeProcessed     Float?
  bilgeDischargedOws Float? // discharged through OWS
  bilgeLandedAshore  Float?
  bilgeRetained      Float?
  bilgeRemarks       String?

  // Sludge — always m³, no unit picker.
  sludgeGenerated             Float?
  sludgeRetained               Float?
  sludgeTransferredIncinerator Float?
  sludgeLandedAshore           Float?
  sludgeRemarks                String?

  garbageEntries GarbageLedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([vesselId, year, month])
  @@index([companyId, vesselId, year, month])
}

model GarbageLedgerEntry {
  id                   String            @id @default(uuid())
  companyId            String
  environmentRecordId  String
  environmentRecord    EnvironmentRecord @relation(fields: [environmentRecordId], references: [id], onDelete: Cascade)
  category             GarbageCategory
  overboardToSeaCbm    Float?
  incineratedCbm       Float?
  dischargeAshoreCbm   Float?
  // Total Garbage is NOT stored — derived at read time as the sum of the
  // three fields above, same convention as VoyageLogBunker.consumed.

  @@unique([environmentRecordId, category])
  @@index([companyId, environmentRecordId])
}

// Atomic counter backing every module's sequential reference number
// (DR-2026-0001, INC-2026-0001, CF-2026-0001, ...). A plain
// count()-then-format is a race condition under concurrent writes — two
// submissions at the same instant (e.g. two vessels reporting at once) can
// both read the same count and both try to create the same refNo, tripping
// the model's own @@unique([companyId, refNo]) as a hard error rather than
// silently colliding. This table makes allocation a single atomic
// INSERT ... ON CONFLICT DO UPDATE instead — see lib/ref-sequence.ts.
model RefSequence {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  prefix    String // e.g. "DR-2026", "INC-2026" — includes the year
  seq       Int     @default(0)

  @@id([companyId, prefix])
}

// ─── TMSA Hub — office-only TMSA 3 self-assessment + audit CAP tracker ────────
// Ported from the Swan-GCC (GM Command Center) app's TMSA module. Company-wide
// (not per-vessel) — TMSA is a fleet-level OCIMF self-assessment, not a
// per-ship record. Never surfaced to SHIPBOARD-department users (no
// tmsa:* permission is granted to the Ship Officer role in prisma/seed.ts).

enum TmsaComplianceStatus {
  YES
  NO
}

// Company Response revision lifecycle for a KPI's narrative answer:
//   ON_OCIMF = the version currently uploaded on the OCIMF website (baseline)
//   REVISED  = edited locally, a new revision pending OCIMF upload
enum TmsaResponseState {
  ON_OCIMF
  REVISED
}

enum TmsaFindingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Per-KPI self-assessment answer from the official OCIMF TMSA 3 report — the
// "live" source of truth. The Score Matrix's live view is computed from these
// rows rather than the imported TmsaScore snapshot (see getLiveMatrix).
model TmsaAssessment {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code             String // "1.2.3" — element.stage.question
  elementNumber    Int // base element 1..13
  elementCode      String @default("") // "1", "1A"
  stage            Int // Stage 1..4
  questionNo       Int    @default(0)
  kpiDescription   String @db.Text // the KPI question text
  complianceStatus TmsaComplianceStatus
  remarks          String? @db.Text // Swan's narrative answer (Company Response)
  bpg              String? @db.Text // Best Practice Guidance

  revision      Int               @default(1) // Rev 1 = the upload baseline
  responseState TmsaResponseState @default(ON_OCIMF)
  revisedAt     DateTime? // when the response was last edited
  uploadedAt    DateTime? // when the current revision was marked uploaded to OCIMF

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, code])
  @@index([companyId, elementCode])
}

// TMSA 3 self-assessment score tracker — one row per (year, element),
// mirrors an imported "TMSA 3 Score" workbook. Company-wide, historical
// snapshot (the Score Matrix's "Live" view uses TmsaAssessment instead;
// this is what a past assessment year actually scored).
model TmsaScore {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  year        Int // Assessment year, e.g. 2025
  elementCode String // "1", "1A", "2", ... "13"
  elementBase Int // Numeric base element (1..13) for grouping
  sortOrder   Int // Preserve sheet row order (1, 1A, 2, 3, 3A, ...)
  title       String

  s1Yes Int
  s1Req Int
  s2Yes Int
  s2Req Int
  s3Yes Int
  s3Req Int
  s4Yes Int
  s4Req Int

  noCount      Int // No. of "No" answers
  reqTotal     Int // No. of Req. (total KPIs across stages)
  rating       Float // Rating out of 4 = totalYes / reqTotal * 4
  stageCleared Int // Whole-number stage cleared

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, year, elementCode])
}

// TMSA audit finding + corrective action (CAP) — company-level. `source` is
// deliberately a free-text field (not an enum) — an oil-major/vetting
// company audit source list is open-ended, not a fixed set.
model TmsaFinding {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code        String // e.g. "TMSA-001"
  seq         Int // numeric order parsed from code, for stable sorting
  auditYear   Int
  elementCode String // "1", "1A", ... "13"
  elementBase Int // numeric base element (1..13) for grouping
  stageQ      String // raw "Stage/Q" from the report, e.g. "2.0"
  // TMSA numbering (Element.Stage.Question) parsed from the observation, so a
  // finding maps to a specific KPI. questionNo = 0 when only element+stage known.
  stage       Int    @default(0)
  questionNo  Int    @default(0)
  kpiRef      String @default("") // "1.2.1" or "1.2" when question unknown
  source      String // Internal, Equinor, Chevron, ...
  observation String @db.Text
  correctiveAction String @db.Text
  status      TmsaFindingStatus @default(OPEN)
  responsible String
  target      String // free text: date, "COMPLETED", "Ongoing", "Q3 2026", ...

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, code])
  @@index([companyId, elementCode])
  @@index([companyId, status])
}

// ─── Procurement — Stage A (Phase 0 setup + Phase 1 vessel side) ─────────────
// Requisition numbering format: {VesselCode}-{YY}RQ-{CATEGORY}-{NNN}, e.g.
// "ESM-26RQ-DECK-001" — see lib/ref-sequence.ts's allocateRefNo, reused as-is
// with pad: 3. Office screening/RFQ/PO (Phase 2) and GRN/status dashboard
// (Phase 3) are a deliberately separate follow-up build — see
// features/procurement/.

enum StoresCategory {
  DECK
  ENGINE
  TOOLS
  GALLEY
  STATIONERY
  PAINTS
  CHEMICALS
  MEDICINE
  PROVISIONS
  SAFETY
  FIREFIGHTING
  BOOKS_CHARTS
  NAVIGATION
  PORTABLE_RADIOS
  IMO_STICKERS
}

// The vessel's onboard department making the request — independent of
// RequisitionCategory below, which is what kind of item/catalogue the lines
// are drawn from (e.g. an Engine department request can still be for
// Provisions or Stationery, not only Engine-store items).
enum RequisitionDepartment {
  DECK
  ENGINE
}

// Requisition-number CATEGORY segment — every StoresCategory plus SPARES
// (for Spares Catalogue requisitions). Distinct from StoresCategory since
// StoresCatalogueItem.category must never allow "SPARES" as a value.
enum RequisitionCategory {
  DECK
  ENGINE
  TOOLS
  GALLEY
  STATIONERY
  PAINTS
  CHEMICALS
  MEDICINE
  PROVISIONS
  SAFETY
  FIREFIGHTING
  BOOKS_CHARTS
  NAVIGATION
  PORTABLE_RADIOS
  IMO_STICKERS
  SPARES
}

// Per-vessel (not fleet-wide — real fleet practice showed two vessels'
// catalogues genuinely diverge, e.g. Esmeralda's real Deck Inventory import
// vs. another ship's own stores). Mirrors SparesCatalogueItem's shape.
// Category-specific compliance fields are flat nullable columns (same
// convention as VoyageLog/EnvironmentRecord's wide-table-with-nullable-
// domain-fields) rather than subtype tables — this fleet's category set is
// small and fixed.
model StoresCatalogueItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  // Optional — confirmed against the fleet's real inventory sheets that IMPA
  // coding isn't actually used onboard; items are identified by description
  // + physical location instead. Kept as an optional field for whichever
  // items a user does want to code.
  impaCode String?
  name     String
  category StoresCategory
  // Reuses RequisitionDepartment (Deck/Engine) — the same "which onboard
  // department" concept as on a Requisition, just at the catalogue-item
  // level so Opening Stock Take / Inventory can group by department first.
  // Independent of category: e.g. "Safety Requisition" or "Navigation"
  // items still belong to one department or the other.
  department RequisitionDepartment @default(DECK)
  unit       String // "pc", "ltr", "kg", ...
  active     Boolean @default(true)

  // The sub-heading within a location on the real sheets — sometimes an
  // equipment name ("Cargo Heater"), sometimes a purpose ("Use for Cargo
  // Tank"). Free text on purpose since Stores items aren't always tied to
  // a piece of equipment the way Spares are.
  subGroup String?
  // Free-text specs/part numbers/notes — mirrors the real form's REMARKS
  // column (e.g. "440V 1KW", "Part No. B05-0030").
  remarks String? @db.Text

  // Medicine
  requiresExpiryTracking Boolean @default(false)
  medicalChestCompliance Boolean @default(false) // tracked against the medical chest list

  // Chemicals
  imoHazardClass String? // e.g. "8" (corrosive) — the SDS itself lives in Attachments

  // Paints
  shelfLifeMonths Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, vesselId, impaCode])
  @@index([companyId, vesselId, category])
}

// Per-vessel. Identified by Maker + Equipment + Part No., not IMPA.
model SparesCatalogueItem {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  makerName     String
  equipmentName String
  partNo        String
  description   String?
  unit          String
  // Physical stowage — same convention as StoresCatalogueItem.location
  // (e.g. "Bosun Store Box No. 11"). Naturally unambiguous here since this
  // model is already per-vessel.
  location      String?
  // ISM 10.3 — not optional. Drives a required badge on every requisition
  // line (and, in a later build, a stricter routing rule).
  criticalSpare Boolean @default(false)
  active        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, vesselId, makerName, partNo])
  @@index([companyId, vesselId])
}

enum StockTakeStatus {
  DRAFT
  POSTED
}

// One-time per vessel — the gate. A vessel's Requisition module stays locked
// until this is POSTED. @@unique enforces "once ever," not a recurring
// stocktake type.
model OpeningStockTake {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  status   StockTakeStatus @default(DRAFT)
  postedAt DateTime?
  postedBy String?

  lines InventoryEvent[] // OPENING-type events this stock take generated, once posted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // vesselId alone (not the companyId, vesselId pair) backs the 1:1 relation
  // on Vessel.openingStockTake — fine since a vesselId is already scoped to
  // exactly one company by definition.
  @@unique([vesselId])
  @@index([companyId])
}

enum InventoryItemType {
  STORES
  SPARES
}

enum InventoryEventType {
  OPENING
  ISSUED
  RECEIVED // written when a vessel receives a FOR_DELIVERY requisition line
  ADJUSTMENT
}

// Matches the real inventory report's split balance columns (New / Usable /
// Reconditioned) — the fleet doesn't track one flat ROB number, it tracks
// three condition buckets per item.
enum InventoryCondition {
  NEW
  USABLE
  RECONDITIONED
}

// The append-only inventory ledger. ROB is never stored — always
// SUM(quantity) computed at read time (see getCurrentRob/getRobByCondition
// in features/procurement/queries.ts), grouped by `condition` to reproduce
// the New/Usable/Reconditioned split. itemType+itemId is a deliberate loose
// (non-FK) polymorphic reference — same convention as
// Attachment.entityType/entityId — since itemId points at one of two
// different tables depending on itemType.
model InventoryEvent {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  itemType InventoryItemType
  itemId   String

  eventType InventoryEventType
  condition InventoryCondition @default(USABLE)
  quantity  Float // signed: +40 opening, -5 issued, +12 received, ±2 adjustment
  reason    String? // required (enforced in the action) for ADJUSTMENT

  // Physical stowage as reported by the vessel at the time of this event
  // (e.g. "Bosun Store", "Paint Locker") — kept to the general area only.
  // Lives here rather than on StoresCatalogueItem because Stores is
  // fleet-wide but stowage isn't — two vessels' Bosun Store hold different
  // things. Set on OPENING events (the ship labels it while counting);
  // ISSUED/ADJUSTMENT typically leave it null since they don't relocate
  // anything.
  location String?
  // Sub-detail within Location that doesn't belong in the location name
  // itself — box/bin number, shelf, "beside C/O cabin", etc. (e.g.
  // "Box No. 3"). Split out so the same physical area (many box numbers)
  // consolidates to one Location suggestion instead of a distinct string
  // per box.
  remarks String?

  // Loose reference back to what generated this event — same non-FK-string
  // convention as above, for a "why did ROB change" audit trail without a
  // hard dependency on every possible source module.
  sourceType String? // "OPENING_STOCK_TAKE" | "MANUAL" | "REQUISITION"
  sourceId   String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  createdBy  String?

  openingStockTakeId String?
  openingStockTake   OpeningStockTake? @relation(fields: [openingStockTakeId], references: [id])

  @@index([companyId, vesselId, itemType, itemId])
}

enum InventoryUpdateStatus {
  DRAFT
  POSTED
}

// A scratch "Update Inventory" grid the crew can save mid-review before
// committing — the InventoryEvent ledger above is append-only by design, so
// nothing here becomes a real event until posted. Lines are kept as a JSON
// blob rather than a child table: they're wholly replaced on every save
// (never queried or edited individually) and become irrelevant the moment
// they're posted, so a line-per-row table would just be overhead.
model InventoryUpdateDraft {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  // The Deck/Engine/Spares + Category scope this draft was built from —
  // null department means the Spares scope (no department of its own); null
  // category means "All Categories" within that department.
  department RequisitionDepartment?
  category   StoresCategory?

  status     InventoryUpdateStatus @default(DRAFT)
  occurredAt DateTime // the effective date chosen when the draft was last saved
  linesJson  Json // UpdateInventoryLine[] — { itemType, itemId, eventType, condition, quantity, reason }

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  postedAt  DateTime?
  postedBy  String?

  @@index([companyId, vesselId, status])
}

enum RequisitionRevisionStatus {
  DRAFT
  PENDING_MASTER_APPROVAL
  APPROVED_BY_MASTER // locked; refNo assigned.
  SENT_TO_OFFICE // office screening — cancel/revise lines (procurement:office-review)
  FOR_QUOTATION // office sent the (screened) requisition out to supplier(s) for pricing
  FOR_DELIVERY // a quotation was picked; deliveryPort is set; vessel is waiting on the goods
  RECEIVED // every non-cancelled line has qtyReceived covering its approved/requested qty — terminal
  CLOSED // ended without every line arriving (supplier never quoted/shipped, or office cancelled it) — terminal; whatever WAS received stays posted, the rest just goes unfulfilled. A vessel that still needs it raises a fresh requisition rather than reopening this one.
}

enum RequisitionLineItemType {
  STORES
  SPARES
  NON_CATALOGUE
}

// Stable parent — mirrors RiskAssessmentDocument/RiskAssessmentRevision
// (features/risk/): the refNo lives here (assigned once, at first Master
// approval) and never changes across revisions.
model Requisition {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  vesselId  String
  vessel    Vessel  @relation(fields: [vesselId], references: [id])

  refNo      String? // null until first APPROVED_BY_MASTER; e.g. "ESM-26RQ-DECK-001"
  category   RequisitionCategory // drives the ref number's CATEGORY segment
  department RequisitionDepartment @default(DECK) // onboard department requesting — set explicitly at creation; default only backs pre-existing rows

  currentRevisionId String?               @unique
  currentRevision   RequisitionRevision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id])
  revisions         RequisitionRevision[] @relation("DocumentRevisions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, vesselId])
}

model RequisitionRevision {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  requisitionId String
  requisition   Requisition @relation("DocumentRevisions", fields: [requisitionId], references: [id], onDelete: Cascade)
  revisionNo    Int

  status RequisitionRevisionStatus @default(DRAFT)

  requestedBy      String? // officer name/rank at time of request — not every requester (Cook, Bosun) is necessarily a system User
  masterApprovedAt DateTime?
  masterApprovedBy String?
  sentToOfficeAt   DateTime?

  // Office pipeline past SENT_TO_OFFICE — kept as simple status/timestamp
  // fields rather than a Quotation/Supplier model; picking a quotation
  // happens outside the system (email/phone), the office just records the
  // outcome here once one's chosen.
  forQuotationAt DateTime?
  forDeliveryAt  DateTime?
  deliveryPort   String? // set when moving to FOR_DELIVERY — where the vessel should expect the goods
  receivedAt     DateTime? // set once every non-cancelled line's qtyReceived covers what was approved/requested

  // Closing out FOR_QUOTATION/FOR_DELIVERY without everything arriving —
  // e.g. the supplier never quoted, or never shipped a line. Whatever was
  // already received (if any) stays posted; the requisition just stops
  // waiting on the rest.
  closedAt     DateTime?
  closedBy     String?
  closeReason  String?

  currentOf Requisition? @relation("CurrentRevision") // back-pointer, populated only when this IS the current revision

  lines RequisitionLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([requisitionId, revisionNo])
}

model RequisitionLine {
  id         String               @id @default(uuid())
  companyId  String
  revisionId String
  revision   RequisitionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  itemType                RequisitionLineItemType
  itemId                  String? // StoresCatalogueItem.id or SparesCatalogueItem.id — null for NON_CATALOGUE
  nonCatalogueDescription String? // required when itemType = NON_CATALOGUE
  // Only meaningful for NON_CATALOGUE lines — a catalogue item already has
  // its own unit/impaCode, always read live from the catalogue instead.
  // Lets the requester hand office a starting point when they already know
  // it, without that becoming an official catalogue entry on its own.
  unit     String?
  impaCode String?

  qtyRequested     Float
  robAtRequestTime Float? // snapshot of computed ROB when the line was added
  // Requisition-specific context (e.g. "for engine overhaul", "urgent — main
  // engine down") — independent of the catalogue item's own remarks, which
  // just describe the item itself. Editable regardless of item type.
  remarks String?

  // Office screening (once the requisition reaches SENT_TO_OFFICE) — kept
  // separate from qtyRequested rather than overwriting it, so what the
  // vessel actually asked for stays on record even after the office revises
  // it. Null qtyApproved means "office hasn't touched this line yet";
  // whatever the vessel requested still stands.
  qtyApproved Float?
  cancelled   Boolean   @default(false)
  cancelledAt DateTime?
  cancelledBy String?

  // Cumulative across every receiving action on this line (deliveries can
  // arrive in more than one batch) — each individual receipt is also its
  // own InventoryEvent (eventType RECEIVED, sourceType "REQUISITION"), so
  // this running total is a fast completeness check, not the only record.
  qtyReceived Float @default(0)

  createdAt DateTime @default(now())
  createdBy String?

  @@index([companyId, revisionId])
}
