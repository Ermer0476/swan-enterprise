  inspectorName     String
  port              String?
  inspectionDate    DateTime
  inspectionType    SireInspectionType?
  sireVersion       String?             @default("2.0")
  overallResult     SireOverallResult?
  summary           String? // "Remarks" in the UI

  status   InspectionStatus @default(OPEN)
  closedAt DateTime?

  observations SireObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, status])
