// ─── Phase 1 module: Committee Meetings (ADM-04 / RC-013) ─────────────────────
//  A vessel's monthly committee meeting(s) per ADM-04 — Safety, Maintenance,
//  Health & Hygiene, and Shipboard Management Team each have their own fixed
//  agenda template (see lib in features/committee-meetings/schema.ts); a
//  single meeting instance can combine several committee types at once (the
//  "type of meeting" shown to the user is simply the distinct set of
//  committeeType values across its agenda items). OTHERS covers ad hoc /
//  extraordinary meetings with no fixed template — their agenda items are
//  freely authored (custom label) rather than pulled from AGENDA_TEMPLATES.
enum CommitteeType {
  SAFETY
  MAINTENANCE
  HEALTH_HYGIENE
  SHIPBOARD_MANAGEMENT_TEAM
  OTHERS
}

enum CommitteeMeetingStatus {
  DRAFT
  REPORTED
  CLOSED
}

model CommitteeMeeting {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Null while status = DRAFT — assigned once on the first "Report Meeting"
  // and never reassigned again, even across a later revert-and-resend cycle.
  refNo     String?

  vesselId String? // null = shore/office-originated record
  vessel   Vessel? @relation(fields: [vesselId], references: [id])

  position    String? // vessel's location at time of meeting, e.g. "TEMA, GHANA - ANCHORAGE"
  meetingDate DateTime
  meetingTime String? // free text — often a range, e.g. "1100H-1130"

  chairman     String?
  inCharge     String?
  members      String? // free text, one per line
  inAttendance String? // free text, one per line

  // Crew who could not attend and must acknowledge the minutes separately.
  forAcknowledgement String?

  vesselRemarks String? // Master's overall closing remarks
  shoreRemarks  String? // office's overall reply — required before Close

  status     CommitteeMeetingStatus @default(DRAFT)
  reportedAt DateTime? // set (and refreshed) every time the vessel reports
  closedAt   DateTime? // set when the office closes it out
  // True the moment the vessel edits+re-reports a meeting the office has
  // already closed once — cleared when the office closes it again. Lets the
  // office notice "the vessel changed something since I last reviewed this"
  // without losing the shoreRemarks/agenda shoreComments already on file.
  revisedAfterReview Boolean @default(false)

  agendaItems CommitteeMeetingAgenda[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, refNo])
  @@index([companyId, vesselId])
}

model CommitteeMeetingAgenda {
  id        String           @id @default(uuid())
  companyId String
  meetingId String
  meeting   CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Stable ordinal for numbering ("1", "2", "3"…) — assigned once at
  // creation, so it doesn't shift if an earlier item is later deleted.
  seq           Int
  committeeType CommitteeType
  code          String? // "A", "B"… for fixed-template items; null for ad hoc Others topics
  label         String // full agenda line text
  details       String? // discussion details, filled in by the vessel
  shoreComments String? // office's per-item reply, once reviewed

  createdAt DateTime @default(now())

  @@index([meetingId])
}

