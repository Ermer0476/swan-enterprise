# ─── SWAN Enterprise environment ───────────────────────────────────────────
# Copy to `.env` and fill in real values.

# PostgreSQL connection string.
# Local (Postgres.app / Homebrew):  postgresql://postgres:postgres@localhost:5432/swan_enterprise
# Neon (free cloud):                postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DigitalOcean Managed:             postgresql://USER:PASSWORD@HOST:25060/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swan_enterprise?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Attachment storage. Until DigitalOcean Spaces is wired up, files are
# written to local disk at this path (outside `public/`, served only through
# the authenticated /api/attachments/[id] route). Leave unset to default to
# <project-root>/storage/attachments — but set it explicitly if your process
# manager doesn't guarantee cwd == the project root.
ATTACHMENTS_STORAGE_DIR=""

# DigitalOcean Spaces (S3-compatible) — attachments storage, once adopted.
SPACES_ENDPOINT=""
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_KEY=""
SPACES_SECRET=""
